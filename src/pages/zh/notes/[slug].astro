---
import { getCollection, type CollectionEntry } from 'astro:content';
import NoteDetailPage from '../../../components/NoteDetailPage.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.lang === 'zh');
  return notes.map((entry) => ({
    params: { slug: entry.data.slugKey },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'notes'>;
}

const { entry } = Astro.props;
---

<NoteDetailPage entry={entry} lang="zh" />
