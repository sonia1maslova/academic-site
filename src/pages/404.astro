---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath } from '../utils/paths';
---

<BaseLayout lang="en" title="Page not found" alternateHref={localePath('zh', '')}>
  <section class="grid grid-cols-12 gap-x-8 gap-y-8 pt-14 md:pt-24">
    <p class="display col-span-12 text-[clamp(8rem,26vw,20rem)] leading-[0.8] text-accent italic md:col-span-7">
      404
    </p>
    <div class="col-span-12 self-end md:col-span-5">
      <p class="eyebrow">Erratum · 勘误</p>
      <h1 class="display mt-4 text-[2.6rem] leading-[1] text-ink">
        This page is <em>out of print.</em>
      </h1>
      <p class="mt-4 text-ink-2">页面不存在或已移动。</p>
      <div class="mt-8 flex flex-wrap gap-x-7 gap-y-3">
        <a href={localePath('en', '')} class="btn-text">Home <span aria-hidden="true">→</span></a>
        <a href={localePath('zh', '')} class="btn-text" lang="zh-CN">返回中文首页 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
