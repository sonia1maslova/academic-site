---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath } from '../utils/paths';
---

<BaseLayout lang="en" title="Page Not Found" alternateHref={localePath('zh', '')}>
  <section class="mx-auto max-w-lg py-16 text-center">
    <p class="font-mono-meta text-xs uppercase tracking-[0.2em] text-[var(--accent)]">404</p>
    <h1 class="mt-3 text-3xl font-semibold text-[var(--fg)]">Page not found · 页面未找到</h1>
    <p class="mt-3 text-sm text-[var(--fg-muted)]">
      The page you requested does not exist or may have moved.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a
        href={localePath('en', '')}
        class="rounded-lg px-4 py-2 text-sm font-medium"
        style="background-color: var(--accent); color: var(--bg);"
      >
        Back to Home (EN)
      </a>
      <a
        href={localePath('zh', '')}
        class="rounded-lg border border-[var(--border)] px-4 py-2 text-sm font-medium text-[var(--fg)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
      >
        返回中文首页
      </a>
    </div>
  </section>
</BaseLayout>
