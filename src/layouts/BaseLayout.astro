---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '../styles/global.css';
import { profile } from '../data/profile';
import { ui } from '../i18n/ui';
import { withBase, type Locale } from '../utils/paths';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  alternateHref?: string;
}

const { lang, title, description, alternateHref } = Astro.props;
const labels = ui[lang];
const baseTitle = `${profile.name.en} — ${labels.siteTagline}`;
const pageTitle = title ? `${title} — ${profile.name.en}` : baseTitle;
const pageDesc = description ?? profile.dek[lang];
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta name="author" content={profile.name.en} />
    <meta name="theme-color" content="#f3efe6" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{pageTitle}</title>

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('academic-site-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} alternateHref={alternateHref} />
    <main class="wrap flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
