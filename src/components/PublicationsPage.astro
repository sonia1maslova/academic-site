---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';
import type { Locale } from '../utils/paths';
import PageHeader from './PageHeader.astro';
import PublicationCard from './PublicationCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const labels = ui[lang].publications;

const publications = (await getCollection('publications')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
const years = Array.from(new Set(publications.map((p) => p.data.year))).sort((a, b) => b - a);
const filters = (['all', 'journal', 'preprint', 'conference'] as const).map((key) => ({
  key,
  label: labels[key],
  count: key === 'all' ? publications.length : publications.filter((p) => p.data.type === key).length,
}));
---

<BaseLayout lang={lang} title={`${labels.title} ${labels.em}`} description={labels.subtitle}>
  <PageHeader
    kicker={labels.kicker}
    title={labels.title}
    titleEm={labels.em}
    lede={labels.subtitle}
    meta={`${publications.length} ${labels.entries}`}
  />

  <div class="mt-14 flex flex-wrap gap-x-7 gap-y-2 border-b border-rule pb-3" role="group">
    {filters.map((f, idx) => (
      <button
        type="button"
        class="filter-btn"
        data-pub-filter={f.key}
        aria-pressed={idx === 0 ? 'true' : 'false'}
      >
        <span>{f.label}</span>
        <sup>{f.count}</sup>
      </button>
    ))}
  </div>

  {years.map((year) => (
    <section class="mt-14 grid grid-cols-12 gap-x-8 border-t border-ink pt-5" data-year-group>
      <div class="col-span-12 md:col-span-3">
        <p class="display text-[clamp(3.2rem,6.5vw,5.4rem)] leading-[0.85] text-ink italic md:sticky md:top-24">
          {year}
        </p>
      </div>
      <div class="col-span-12 md:col-span-9">
        {publications
          .filter((p) => p.data.year === year)
          .map((pub) => <PublicationCard entry={pub} lang={lang} />)}
      </div>
    </section>
  ))}

  <p class="mt-16 text-center text-ink-3 italic" data-pub-empty hidden>{labels.empty}</p>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-pub-filter]');
  const items = document.querySelectorAll<HTMLElement>('.pub-item');
  const groups = document.querySelectorAll<HTMLElement>('[data-year-group]');
  const empty = document.querySelector<HTMLElement>('[data-pub-empty]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.pubFilter ?? 'all';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      items.forEach((item) => {
        const show = key === 'all' || item.dataset.pubType === key;
        item.toggleAttribute('hidden', !show);
        if (show) shown += 1;
      });
      groups.forEach((g) => {
        g.toggleAttribute('hidden', g.querySelector('.pub-item:not([hidden])') === null);
      });
      empty?.toggleAttribute('hidden', shown > 0);
    });
  });
</script>
