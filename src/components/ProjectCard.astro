---
import type { CollectionEntry } from 'astro:content';
import { ui } from '../i18n/ui';
import type { Locale } from '../utils/paths';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Locale;
  index: number;
  compact?: boolean;
}

const { entry, lang, index, compact = false } = Astro.props;
const { data } = entry;
const labels = ui[lang];
const title = lang === 'zh' ? data.titleZh : data.title;
const summary = lang === 'zh' ? data.summaryZh : data.summary;
const highlights = lang === 'zh' ? data.highlightsZh : data.highlights;
const categoryLabel = labels.projects[data.category];

type LinkItem = { label: string; href: string };
const candidates: [string, string | undefined][] = [
  [labels.actions.github, data.links.github],
  [labels.actions.pypi, data.links.pypi],
  [labels.actions.gallery, data.links.gallery],
  [labels.actions.demo, data.links.demo],
  [labels.actions.paper, data.links.paper],
];
const links: LinkItem[] = candidates
  .filter((c): c is [string, string] => Boolean(c[1]))
  .map(([label, href]) => ({ label, href }));
---

<li
  class="project-item group grid grid-cols-12 gap-x-6 gap-y-4 border-b border-rule py-8 md:py-10"
  data-project-category={data.category}
>
  <p class="col-span-12 font-mono text-[10.5px] tracking-[0.12em] text-ink-3 md:col-span-1 md:pt-3">
    {String(index + 1).padStart(2, '0')}
  </p>

  <div class="col-span-12 md:col-span-7">
    <h3 class="display text-[clamp(1.85rem,3.4vw,2.7rem)] leading-[1.02] text-ink transition-colors group-hover:text-accent">
      {data.links.github ? (
        <a href={data.links.github} target="_blank" rel="noopener noreferrer">{title}</a>
      ) : (
        title
      )}
    </h3>
    <p class="mt-4 max-w-2xl text-[1.02rem] leading-relaxed text-ink-2">{summary}</p>
    {!compact && highlights.length > 0 && (
      <ul class="dash-list mt-5 max-w-2xl text-[15px] leading-relaxed text-ink-2">
        {highlights.map((item) => <li>{item}</li>)}
      </ul>
    )}
    {data.tags.length > 0 && (
      <p class="mt-5 font-mono text-[10.5px] tracking-[0.06em] text-ink-3">
        {data.tags.join('  /  ')}
      </p>
    )}
  </div>

  <div class="col-span-12 flex flex-wrap items-baseline gap-x-6 gap-y-3 md:col-span-4 md:flex-col md:items-end md:text-right">
    <p class="eyebrow">
      <span class="text-ink">{categoryLabel}</span> · {data.year}
    </p>
    {data.language && <p class="eyebrow">{data.language}</p>}
    <div class="flex flex-wrap gap-x-5 gap-y-2 md:mt-3 md:justify-end">
      {links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer" class="btn-text">
          {l.label} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</li>
