---
import BaseLayout from '../layouts/BaseLayout.astro';
import { timelineNodes } from '../data/timeline';
import { ui } from '../i18n/ui';
import type { Locale } from '../utils/paths';
import InteractiveTimeline from './InteractiveTimeline.astro';
import PageHeader from './PageHeader.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const labels = ui[lang].timeline;
const years = timelineNodes.map((n) => n.year);
const span = `${Math.min(...years)} — ${Math.max(...years)}`;
---

<BaseLayout lang={lang} title={`${labels.title} ${labels.em}`} description={labels.subtitle}>
  <PageHeader
    kicker={labels.kicker}
    title={labels.title}
    titleEm={labels.em}
    lede={labels.subtitle}
    meta={`${span} · ${timelineNodes.length} ${labels.entries}`}
  />

  <section class="band band-ink mt-14 py-12 md:mt-20 md:py-16">
    <div class="wrap">
      <InteractiveTimeline lang={lang} compact={false} />
    </div>
  </section>
</BaseLayout>
