---
import type { CollectionEntry } from 'astro:content';
import { profile } from '../data/profile';
import { ui } from '../i18n/ui';
import type { Locale } from '../utils/paths';

interface Props {
  entry: CollectionEntry<'publications'>;
  lang: Locale;
}

const { entry, lang } = Astro.props;
const { data } = entry;
const labels = ui[lang];
const title = lang === 'zh' && data.titleZh ? data.titleZh : data.title;
const abstractText = lang === 'zh' && data.abstractZh ? data.abstractZh : data.abstract;
const safeId = entry.id.replace(/[^a-zA-Z0-9_-]/g, '-');
const typeLabel = labels.publications[data.type];
const isOwn = (author: string) => author.toLowerCase().includes(profile.name.en.toLowerCase());

type LinkItem = { label: string; href: string };
const candidates: [string, string | undefined][] = [
  [labels.actions.paper, data.links.paper],
  [labels.actions.preprint, data.links.preprint],
  [labels.actions.code, data.links.code],
  [labels.actions.gallery, data.links.gallery],
  [labels.actions.slides, data.links.slides],
];
const links: LinkItem[] = candidates
  .filter((c): c is [string, string] => Boolean(c[1]))
  .map(([label, href]) => ({ label, href }));
---

<article class="pub-item border-b border-rule py-7" data-pub-type={data.type}>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <p class="eyebrow">
      <span class="text-accent">{typeLabel}</span> · {data.year}
    </p>
    {data.isTemplate && <span class="template-chip">{labels.publications.templateBadge}</span>}
  </div>

  <h3 class="mt-3 text-[1.3rem] leading-snug font-medium text-ink md:text-[1.4rem]">{title}</h3>

  <p class="mt-2 text-[15.5px] leading-relaxed text-ink-2">
    {data.authors.map((author, idx) => (
      <>
        {isOwn(author) ? (
          <span class="font-semibold text-ink underline decoration-accent decoration-1 underline-offset-4">
            {author}
          </span>
        ) : (
          <span>{author}</span>
        )}
        {idx < data.authors.length - 1 && ', '}
      </>
    ))}
  </p>
  <p class="mt-1 text-[15.5px] text-ink-3 italic">{data.venue}</p>

  <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
    {abstractText && (
      <button type="button" class="btn-text" data-pub-toggle data-target={`abs-${safeId}`} aria-expanded="false">
        {labels.actions.abstract} <span class="pub-sign" aria-hidden="true"></span>
      </button>
    )}
    {data.bibtex && (
      <button type="button" class="btn-text" data-pub-toggle data-target={`bib-${safeId}`} aria-expanded="false">
        {labels.actions.bibtex} <span class="pub-sign" aria-hidden="true"></span>
      </button>
    )}
    {links.map((l) => (
      <a href={l.href} target="_blank" rel="noopener noreferrer" class="btn-text">
        {l.label} <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>

  {abstractText && (
    <div id={`abs-${safeId}`} hidden class="mt-6 border-l-2 border-accent pl-5">
      <p class="text-[1.02rem] leading-relaxed text-ink-2 italic">{abstractText}</p>
    </div>
  )}

  {data.bibtex && (
    <div id={`bib-${safeId}`} hidden class="mt-6 border border-rule bg-paper-2 p-4" data-bib-panel>
      <div class="mb-3 flex items-center justify-between">
        <span class="eyebrow">BibTeX</span>
        <button
          type="button"
          class="btn-text"
          data-bib-copy
          data-copy={labels.actions.copy}
          data-copied={labels.actions.copied}
        >
          <span data-label>{labels.actions.copy}</span>
        </button>
      </div>
      <pre class="overflow-x-auto font-mono text-[12px] leading-relaxed text-ink"><code>{data.bibtex.trim()}</code></pre>
    </div>
  )}
</article>

<style>
  .pub-sign::after {
    content: '+';
  }
  [aria-expanded='true'] .pub-sign::after {
    content: '−';
  }
</style>

<script>
  const bindPublications = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-pub-toggle]').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const id = btn.dataset.target;
        if (!id) return;
        const panel = document.getElementById(id);
        if (!panel) return;
        const willOpen = panel.hasAttribute('hidden');
        panel.toggleAttribute('hidden', !willOpen);
        btn.setAttribute('aria-expanded', String(willOpen));
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-bib-copy]').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const code = btn.closest('[data-bib-panel]')?.querySelector('code')?.textContent ?? '';
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          const label = btn.querySelector('[data-label]');
          if (!label) return;
          label.textContent = btn.dataset.copied ?? 'Copied';
          window.setTimeout(() => {
            label.textContent = btn.dataset.copy ?? 'Copy';
          }, 1600);
        } catch {
          /* clipboard unavailable */
        }
      });
    });
  };

  bindPublications();
</script>
