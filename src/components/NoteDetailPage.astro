---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../utils/paths';

interface Props {
  entry: CollectionEntry<'notes'>;
  lang: Locale;
}

const { entry, lang } = Astro.props;
const labels = ui[lang];
const { Content } = await render(entry);

const targetLang: Locale = lang === 'en' ? 'zh' : 'en';
const allNotes = await getCollection('notes');
const hasTranslation = allNotes.some(
  (n) => n.data.lang === targetLang && n.data.slugKey === entry.data.slugKey
);
const alternateHref = hasTranslation
  ? localePath(targetLang, `notes/${entry.data.slugKey}`)
  : localePath(targetLang, 'notes');
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.summary} alternateHref={alternateHref}>
  <article class="mx-auto max-w-[44rem] pt-8 md:pt-14">
    <a href={localePath(lang, 'notes')} class="btn-text">
      <span aria-hidden="true">←</span> {labels.actions.backToNotes}
    </a>

    <header class="mt-12 border-b border-ink pb-9">
      <p class="eyebrow">
        {labels.notes.publishedOn} {entry.data.date}
        {entry.data.updated && <> · {labels.notes.updatedOn} {entry.data.updated}</>}
        {' '}· {entry.data.readingTime} {labels.notes.readingTime}
      </p>
      <h1 class="display rise mt-6 text-[clamp(2.7rem,6.4vw,4.6rem)] leading-[0.98] text-ink">
        {entry.data.title}
      </h1>
      <p class="rise rise-2 mt-7 text-[1.28rem] leading-snug text-ink-2 italic">{entry.data.summary}</p>
      {entry.data.tags.length > 0 && (
        <p class="mt-7 font-mono text-[10.5px] tracking-[0.06em] text-ink-3">{entry.data.tags.join(' / ')}</p>
      )}
    </header>

    <div class="prose-ed dropcap mt-12">
      <Content />
    </div>

    <div class="mt-16 border-t border-rule pt-6">
      <a href={localePath(lang, 'notes')} class="btn-text">
        <span aria-hidden="true">←</span> {labels.actions.backToNotes}
      </a>
    </div>
  </article>
</BaseLayout>
