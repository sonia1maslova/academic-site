---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  academicService,
  education,
  honors,
  researchExperience,
  skillGroups,
  type TimelineEntry,
} from '../data/experience';
import { profile } from '../data/profile';
import { t, ui } from '../i18n/ui';
import { withBase, type Locale } from '../utils/paths';
import PageHeader from './PageHeader.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const labels = ui[lang].experience;
const actions = ui[lang].actions;

const timelineGroups: { title: string; entries: TimelineEntry[] }[] = [
  { title: labels.education, entries: education },
  { title: labels.research, entries: researchExperience },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout lang={lang} title={`${labels.title} ${labels.em}`} description={labels.subtitle}>
  <PageHeader kicker={labels.kicker} title={labels.title} titleEm={labels.em} lede={labels.subtitle}>
    <div class="no-print mt-10 flex flex-wrap gap-x-7 gap-y-3">
      {profile.cvPdfPath && (
        <a href={withBase(profile.cvPdfPath)} target="_blank" rel="noopener noreferrer" class="btn-text">
          {actions.downloadCv} (PDF) <span aria-hidden="true">↗</span>
        </a>
      )}
      <button type="button" class="btn-text" id="print-cv-btn">
        {actions.printCv} <span aria-hidden="true">→</span>
      </button>
    </div>
  </PageHeader>

  {timelineGroups.map((group, gi) => (
    <section class="mt-20 grid grid-cols-12 gap-x-8 gap-y-6 border-t border-ink pt-5">
      <div class="col-span-12 md:col-span-4">
        <p class="eyebrow text-accent">{pad(gi + 1)}</p>
        <h2 class="display mt-3 text-[clamp(2.2rem,4vw,3.2rem)] leading-[0.95] text-ink">{group.title}</h2>
      </div>
      <div class="col-span-12 md:col-span-8">
        {group.entries.map((e) => (
          <article class="grid grid-cols-12 gap-x-6 gap-y-2 border-b border-rule py-7 first:pt-1">
            <p class="col-span-12 font-mono text-[10.5px] tracking-[0.1em] text-ink-3 sm:col-span-3 sm:pt-1.5">
              {e.period}
            </p>
            <div class="col-span-12 sm:col-span-9">
              <h3 class="text-[1.22rem] leading-snug font-medium text-ink">{t(e.title, lang)}</h3>
              <p class="mt-1 text-ink-2 italic">
                {t(e.organization, lang)}
                {e.location && <span class="text-ink-3"> — {t(e.location, lang)}</span>}
              </p>
              {e.advisor && <p class="mt-1 text-[15px] text-ink-3">{t(e.advisor, lang)}</p>}
              {e.summary && <p class="mt-3 leading-relaxed text-ink-2">{t(e.summary, lang)}</p>}
              {e.highlights && (
                <ul class="dash-list mt-4 text-[15.5px] leading-relaxed text-ink-2">
                  {e.highlights[lang].map((pt) => <li>{pt}</li>)}
                </ul>
              )}
              {e.isTemplate && <span class="template-chip mt-4">{labels.templateBadge}</span>}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="mt-20 grid grid-cols-12 gap-x-8 gap-y-6 border-t border-ink pt-5">
    <div class="col-span-12 md:col-span-4">
      <p class="eyebrow text-accent">03</p>
      <h2 class="display mt-3 text-[clamp(2.2rem,4vw,3.2rem)] leading-[0.95] text-ink">{labels.honors}</h2>
    </div>
    <ul class="col-span-12 md:col-span-8">
      {honors.map((item) => (
        <li class="grid grid-cols-12 gap-x-6 gap-y-1 border-b border-rule py-5 first:pt-1">
          <p class="col-span-12 font-mono text-[10.5px] tracking-[0.1em] text-ink-3 sm:col-span-3 sm:pt-1.5">
            {item.year}
          </p>
          <div class="col-span-12 sm:col-span-9">
            <p class="text-[1.1rem] font-medium text-ink">{t(item.title, lang)}</p>
            <p class="text-ink-2 italic">{t(item.issuer, lang)}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-20 grid grid-cols-12 gap-x-8 gap-y-6 border-t border-ink pt-5">
    <div class="col-span-12 md:col-span-4">
      <p class="eyebrow text-accent">04</p>
      <h2 class="display mt-3 text-[clamp(2.2rem,4vw,3.2rem)] leading-[0.95] text-ink">{labels.service}</h2>
    </div>
    <div class="col-span-12 md:col-span-8">
      {academicService.map((e) => (
        <article class="grid grid-cols-12 gap-x-6 gap-y-2 border-b border-rule py-7 first:pt-1">
          <p class="col-span-12 font-mono text-[10.5px] tracking-[0.1em] text-ink-3 sm:col-span-3 sm:pt-1.5">
            {e.period}
          </p>
          <div class="col-span-12 sm:col-span-9">
            <h3 class="text-[1.22rem] leading-snug font-medium text-ink">{t(e.title, lang)}</h3>
            <p class="mt-1 text-ink-2 italic">{t(e.organization, lang)}</p>
            {e.summary && <p class="mt-3 leading-relaxed text-ink-2">{t(e.summary, lang)}</p>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-20 grid grid-cols-12 gap-x-8 gap-y-6 border-t border-ink pt-5">
    <div class="col-span-12 md:col-span-4">
      <p class="eyebrow text-accent">05</p>
      <h2 class="display mt-3 text-[clamp(2.2rem,4vw,3.2rem)] leading-[0.95] text-ink">{labels.methods}</h2>
    </div>
    <div class="col-span-12 grid gap-x-8 gap-y-8 sm:grid-cols-3 md:col-span-8">
      {skillGroups.map((group) => (
        <div class="border-t border-rule pt-3">
          <p class="eyebrow">{t(group.label, lang)}</p>
          <ul class="mt-3 space-y-1.5 text-[15.5px] leading-snug text-ink">
            {group.items.map((skill) => <li>{skill}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  document.getElementById('print-cv-btn')?.addEventListener('click', () => window.print());
</script>
