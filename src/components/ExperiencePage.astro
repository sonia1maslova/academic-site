---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  academicService,
  education,
  honors,
  researchExperience,
  skillGroups,
} from '../data/experience';
import { profile } from '../data/profile';
import { t, ui } from '../i18n/ui';
import { withBase, type Locale } from '../utils/paths';
import Icons from './Icons.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const labels = ui[lang];
---

<BaseLayout lang={lang} title={labels.experience.title} description={labels.experience.subtitle}>
  <header class="flex flex-wrap items-end justify-between gap-4 border-b border-[var(--border)] pb-7">
    <div>
      <h1 class="text-3xl font-semibold text-[var(--fg)] sm:text-4xl">
        {labels.experience.title}
      </h1>
      <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-[var(--fg-muted)] sm:text-base">
        {labels.experience.subtitle}
      </p>
    </div>

    <div class="no-print flex flex-wrap items-center gap-2">
      {profile.cvPdfPath && (
        <a
          href={withBase(profile.cvPdfPath)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg px-3.5 py-2 text-xs font-medium"
          style="background-color: var(--accent); color: var(--bg);"
        >
          <Icons name="file" class="h-3.5 w-3.5" />
          <span>{labels.actions.downloadCv} (PDF)</span>
        </a>
      )}
      <button
        type="button"
        id="print-cv-btn"
        class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] px-3.5 py-2 font-mono-meta text-xs text-[var(--fg-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
      >
        <Icons name="printer" class="h-3.5 w-3.5" />
        <span>{labels.actions.printCv}</span>
      </button>
    </div>
  </header>

  <!-- Education -->
  <section class="mt-10">
    <h2 class="text-2xl font-semibold text-[var(--fg)]">{labels.experience.education}</h2>
    <div class="mt-5 space-y-4">
      {education.map((entry) => (
        <article class="surface-card p-5 sm:p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-sans text-base font-semibold text-[var(--fg)]">
              {t(entry.title, lang)}
            </h3>
            <span class="font-mono-meta text-xs text-[var(--fg-faint)]">{entry.period}</span>
          </div>
          <p class="mt-1 text-sm font-medium text-[var(--accent)]">
            {t(entry.organization, lang)}
            {entry.location && (
              <span class="font-normal text-[var(--fg-faint)]">
                {' · '}{t(entry.location, lang)}
              </span>
            )}
          </p>
          {entry.advisor && (
            <p class="mt-1 text-xs text-[var(--fg-muted)]">{t(entry.advisor, lang)}</p>
          )}
          {entry.summary && (
            <p class="mt-2.5 text-sm leading-relaxed text-[var(--fg-muted)]">
              {t(entry.summary, lang)}
            </p>
          )}
          {entry.isTemplate && (
            <span class="template-chip mt-3">{labels.experience.templateBadge}</span>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Research Experience -->
  <section class="mt-12 border-t border-[var(--border)] pt-10">
    <h2 class="text-2xl font-semibold text-[var(--fg)]">{labels.experience.research}</h2>
    <div class="mt-5 space-y-4">
      {researchExperience.map((entry) => (
        <article class="surface-card p-5 sm:p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-sans text-base font-semibold text-[var(--fg)]">
              {t(entry.title, lang)}
            </h3>
            <span class="font-mono-meta text-xs text-[var(--fg-faint)]">{entry.period}</span>
          </div>
          <p class="mt-1 text-sm font-medium text-[var(--accent)]">
            {t(entry.organization, lang)}
          </p>
          {entry.highlights && (
            <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-[var(--fg-muted)]">
              {entry.highlights[lang].map((point) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent)]" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          )}
          {entry.isTemplate && (
            <span class="template-chip mt-3">{labels.experience.templateBadge}</span>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Honors & Awards -->
  <section class="mt-12 border-t border-[var(--border)] pt-10">
    <h2 class="text-2xl font-semibold text-[var(--fg)]">{labels.experience.honors}</h2>
    <ul class="mt-5 divide-y divide-[var(--border)] border-y border-[var(--border)]">
      {honors.map((item) => (
        <li class="grid gap-1 py-3.5 sm:grid-cols-[5rem_1fr] sm:items-baseline sm:gap-5">
          <span class="font-mono-meta text-xs font-medium text-[var(--fg-faint)]">
            {item.year}
          </span>
          <div>
            <p class="text-sm font-medium text-[var(--fg)]">{t(item.title, lang)}</p>
            <p class="text-xs text-[var(--fg-muted)]">{t(item.issuer, lang)}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Academic Service -->
  <section class="mt-12 border-t border-[var(--border)] pt-10">
    <h2 class="text-2xl font-semibold text-[var(--fg)]">{labels.experience.service}</h2>
    <div class="mt-5 space-y-4">
      {academicService.map((entry) => (
        <article class="surface-card p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-sans text-sm font-semibold text-[var(--fg)]">
              {t(entry.title, lang)}
            </h3>
            <span class="font-mono-meta text-xs text-[var(--fg-faint)]">{entry.period}</span>
          </div>
          <p class="mt-0.5 text-xs font-medium text-[var(--accent)]">
            {t(entry.organization, lang)}
          </p>
          {entry.summary && (
            <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">
              {t(entry.summary, lang)}
            </p>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Methods & Technical Skills -->
  <section class="mt-12 border-t border-[var(--border)] pt-10">
    <h2 class="text-2xl font-semibold text-[var(--fg)]">{labels.experience.methods}</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      {skillGroups.map((group) => (
        <div class="surface-card p-5">
          <h3 class="font-sans text-xs font-semibold uppercase tracking-wider text-[var(--accent)]">
            {t(group.label, lang)}
          </h3>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {group.items.map((skill) => (
              <span class="rounded bg-[var(--bg-subtle)] px-2 py-1 font-mono-meta text-[11px] text-[var(--fg-muted)]">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const printBtn = document.getElementById('print-cv-btn');
    if (printBtn) {
      printBtn.addEventListener('click', () => window.print());
    }
  })();
</script>
