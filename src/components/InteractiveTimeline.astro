---
import { timelineNodes, type TimelineCategory } from '../data/timeline';
import { t, ui } from '../i18n/ui';
import { withBase, type Locale } from '../utils/paths';

interface Props {
  lang: Locale;
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const labels = ui[lang].timeline;

const glyphs: Record<TimelineCategory, string> = {
  research:
    '<svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4.2" fill="currentColor"/></svg>',
  software:
    '<svg viewBox="0 0 10 10" aria-hidden="true"><rect x="1" y="1" width="8" height="8" fill="currentColor"/></svg>',
  publication:
    '<svg viewBox="0 0 10 10" aria-hidden="true"><path d="M5 .6 9.6 9.2H.4Z" fill="currentColor"/></svg>',
  education:
    '<svg viewBox="0 0 10 10" aria-hidden="true"><path d="M5 .3 9.7 5 5 9.7.3 5Z" fill="currentColor"/></svg>',
  milestone:
    '<svg viewBox="0 0 10 10" aria-hidden="true"><path d="M5 0v10M0 5h10M1.5 1.5l7 7M8.5 1.5l-7 7" stroke="currentColor" stroke-width="1.7"/></svg>',
};

const sorted = [...timelineNodes].sort((a, b) => a.date.localeCompare(b.date));
const pad = (n: number) => String(n).padStart(2, '0');

const nodes = sorted.map((node, idx) => ({
  id: node.id,
  no: pad(idx + 1),
  shortDate: node.date.slice(0, 7).replace('-', '.'),
  displayDate: t(node.displayDate, lang),
  year: node.year,
  category: node.category,
  categoryLabel: labels.categories[node.category],
  title: t(node.title, lang),
  subtitle: node.subtitle ? t(node.subtitle, lang) : '',
  summary: t(node.summary, lang),
  details: [...node.details[lang]],
  tags: [...node.tags],
  isTemplate: Boolean(node.isTemplate),
  links: (node.links ?? []).map((l) => ({
    label: t(l.label, lang),
    href: withBase(l.href),
    external: l.external !== false,
  })),
}));

const categoryKeys: ('all' | TimelineCategory)[] = [
  'all',
  'research',
  'software',
  'publication',
  'education',
  'milestone',
];
const filters = categoryKeys
  .map((key) => ({
    key,
    label: labels.categories[key],
    count: key === 'all' ? nodes.length : nodes.filter((n) => n.category === key).length,
  }))
  .filter((f) => f.count > 0);

const initial = nodes[nodes.length - 1];
const payloadJson = JSON.stringify({
  nodes,
  glyphs,
  i18n: { templateBadge: labels.templateBadge },
}).replace(/</g, '\\u003c');
---

<div class="chron" data-interactive-timeline data-compact={compact ? 'true' : 'false'}>
  <div class="chron-controls">
    <div class="chron-filters" role="group" aria-label="Filter">
      {filters.map((f, idx) => (
        <button
          type="button"
          class="filter-btn"
          data-tl-filter={f.key}
          aria-pressed={idx === 0 ? 'true' : 'false'}
        >
          {f.key !== 'all' && <span class="glyph" set:html={glyphs[f.key]} />}
          <span>{f.label}</span>
          <sup>{f.count}</sup>
        </button>
      ))}
    </div>

    <div class="chron-nav">
      {!compact && (
        <div class="chron-density" role="group" aria-label={labels.density}>
          <span class="eyebrow">{labels.density}</span>
          <button type="button" data-tl-zoom="compact" aria-pressed="false">{labels.zoomCompact}</button>
          <button type="button" data-tl-zoom="standard" aria-pressed="true">{labels.zoomStandard}</button>
          <button type="button" data-tl-zoom="wide" aria-pressed="false">{labels.zoomWide}</button>
        </div>
      )}
      <button type="button" class="chron-step" data-tl-prev>← {labels.prev}</button>
      <span class="chron-counter" data-tl-counter>
        {initial?.no}<i> / {pad(nodes.length)}</i>
      </span>
      <button type="button" class="chron-step" data-tl-next>{labels.next} →</button>
    </div>
  </div>

  <div class="chron-stage" data-tl-stage tabindex="0" role="region" aria-label={labels.kicker}>
    <div class="chron-year" data-tl-year-big aria-hidden="true">
      <span>{initial?.year}</span>
    </div>
    <div class="chron-axis" aria-hidden="true"></div>
    <div class="chron-head" aria-hidden="true">
      <span class="chron-head-label" data-tl-focus-date>{initial?.shortDate}</span>
    </div>
    <div class="chron-track" data-tl-track></div>
    <div class="chron-fade chron-fade-l" aria-hidden="true"></div>
    <div class="chron-fade chron-fade-r" aria-hidden="true"></div>
    <div class="chron-empty hidden" data-tl-empty>{labels.empty}</div>
    <div class="chron-hint" data-tl-hint aria-hidden="true">{labels.dragHint}</div>
  </div>

  <div class="chron-scrub">
    <div
      class="chron-scrub-track"
      data-tl-scrub
      role="slider"
      aria-label={labels.dragHint}
      aria-valuemin="1"
      aria-valuemax={String(nodes.length)}
      aria-valuenow={String(nodes.length)}
    >
      <div class="chron-scrub-rail"></div>
      <div class="chron-scrub-fill" data-tl-scrub-fill style="width: 100%;"></div>
      <div data-tl-scrub-ticks></div>
      <div class="chron-scrub-thumb" data-tl-scrub-thumb style="left: 100%;"></div>
    </div>
    <div class="chron-scrub-years" data-tl-years></div>
  </div>

  {initial && (
    <article class="chron-detail grid grid-cols-12 gap-x-8 gap-y-8" data-tl-detail aria-live="polite">
      <div class="col-span-12 md:col-span-3">
        <div class="chron-detail-no" data-tl-d-no>{initial.no}</div>
        <p class="eyebrow mt-5" data-tl-d-date>{initial.displayDate}</p>
        <p class="chron-detail-cat" data-tl-d-cat>
          <span class="glyph" set:html={glyphs[initial.category]} />
          {initial.categoryLabel}
        </p>
        <p class:list={['mt-4', !initial.isTemplate && 'hidden']} data-tl-d-tpl>
          <span class="template-chip">{labels.templateBadge}</span>
        </p>
      </div>

      <div class="col-span-12 md:col-span-6">
        <h3 class="chron-detail-title" data-tl-d-title>{initial.title}</h3>
        <p class:list={['eyebrow mt-4', !initial.subtitle && 'hidden']} data-tl-d-sub>
          {initial.subtitle}
        </p>
        <p class="chron-detail-summary" data-tl-d-summary>{initial.summary}</p>
        <div class:list={['mt-7', initial.details.length === 0 && 'hidden']} data-tl-d-points-wrap>
          <p class="eyebrow">{labels.keyPoints}</p>
          <ol class="chron-points" data-tl-d-points>
            {initial.details.map((pt) => <li>{pt}</li>)}
          </ol>
        </div>
      </div>

      <div class="col-span-12 md:col-span-3">
        <p class="eyebrow">{labels.filedUnder}</p>
        <ul class="chron-tags mt-2" data-tl-d-tags>
          {initial.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        <div class:list={['mt-7', initial.links.length === 0 && 'hidden']} data-tl-d-links-wrap>
          <p class="eyebrow">{labels.links}</p>
          <ul class="mt-2" data-tl-d-links>
            {initial.links.map((link) => (
              <li>
                <a
                  class="chron-link"
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  <span>{link.label}</span>
                  <span aria-hidden="true">{link.external ? '↗' : '→'}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </article>
  )}

  <script type="application/json" data-tl-payload set:html={payloadJson} />
</div>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-interactive-timeline]');
    if (!roots.length) return;

    const SPACING = { compact: 236, standard: 296, wide: 372 };
    const esc = (s) =>
      String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
    const pad = (n) => String(n).padStart(2, '0');

    roots.forEach((root) => {
      if (root.dataset.tlInit === '1') return;
      root.dataset.tlInit = '1';

      const q = (sel) => root.querySelector(sel);
      const payloadEl = q('[data-tl-payload]');
      if (!payloadEl) return;
      const payload = JSON.parse(payloadEl.textContent || '{}');
      const allNodes = payload.nodes || [];
      const glyphs = payload.glyphs || {};
      const i18n = payload.i18n || {};

      const stage = q('[data-tl-stage]');
      const track = q('[data-tl-track]');
      if (!stage || !track) return;

      const yearBig = q('[data-tl-year-big]');
      const headEl = q('.chron-head');
      const focusDate = q('[data-tl-focus-date]');
      const emptyEl = q('[data-tl-empty]');
      const hintEl = q('[data-tl-hint]');
      const counter = q('[data-tl-counter]');
      const prevBtn = q('[data-tl-prev]');
      const nextBtn = q('[data-tl-next]');
      const scrub = q('[data-tl-scrub]');
      const scrubFill = q('[data-tl-scrub-fill]');
      const scrubTicks = q('[data-tl-scrub-ticks]');
      const scrubThumb = q('[data-tl-scrub-thumb]');
      const yearsEl = q('[data-tl-years]');
      const filterBtns = root.querySelectorAll('[data-tl-filter]');
      const zoomBtns = root.querySelectorAll('[data-tl-zoom]');

      const detail = q('[data-tl-detail]');
      const d = {
        no: q('[data-tl-d-no]'),
        date: q('[data-tl-d-date]'),
        cat: q('[data-tl-d-cat]'),
        tpl: q('[data-tl-d-tpl]'),
        title: q('[data-tl-d-title]'),
        sub: q('[data-tl-d-sub]'),
        summary: q('[data-tl-d-summary]'),
        pointsWrap: q('[data-tl-d-points-wrap]'),
        points: q('[data-tl-d-points]'),
        tags: q('[data-tl-d-tags]'),
        linksWrap: q('[data-tl-d-links-wrap]'),
        links: q('[data-tl-d-links]'),
      };

      let spacing = root.dataset.compact === 'true' ? SPACING.compact : SPACING.standard;
      let visible = allNodes.slice();
      let nodeEls = [];
      let yearBtnEls = [];
      let activeIndex = -1;
      let shownYear = null;
      let swapTimer = null;

      let stageW = stage.clientWidth || 800;
      let maxX = 0;
      let currentX = 0;
      let targetX = 0;
      let velocity = 0;

      let dragging = false;
      let scrubbing = false;
      let pointerId = null;
      let lastX = 0;
      let lastT = 0;
      let travel = 0;
      let pressedIndex = null;
      let wheelTimer = null;
      let raf = null;
      let interacted = false;

      const nodeX = (i) => i * spacing;
      const pct = (i) => (visible.length > 1 ? (i / (visible.length - 1)) * 100 : 50);
      const nearestIndex = (x) => clamp(Math.round(x / spacing), 0, Math.max(0, visible.length - 1));

      const markInteracted = () => {
        if (interacted || !hintEl) return;
        interacted = true;
        hintEl.style.opacity = '0';
      };

      const fillDetail = (n) => {
        if (!detail) return;
        if (d.no) d.no.textContent = n.no;
        if (d.date) d.date.textContent = n.displayDate;
        if (d.cat) d.cat.innerHTML = `<span class="glyph">${glyphs[n.category] || ''}</span>${esc(n.categoryLabel)}`;
        if (d.tpl) d.tpl.classList.toggle('hidden', !n.isTemplate);
        if (d.title) d.title.textContent = n.title;
        if (d.sub) {
          d.sub.textContent = n.subtitle || '';
          d.sub.classList.toggle('hidden', !n.subtitle);
        }
        if (d.summary) d.summary.textContent = n.summary;
        if (d.pointsWrap && d.points) {
          d.pointsWrap.classList.toggle('hidden', !n.details.length);
          d.points.innerHTML = n.details.map((p) => `<li>${esc(p)}</li>`).join('');
        }
        if (d.tags) d.tags.innerHTML = n.tags.map((tg) => `<li>${esc(tg)}</li>`).join('');
        if (d.linksWrap && d.links) {
          d.linksWrap.classList.toggle('hidden', !n.links.length);
          d.links.innerHTML = n.links
            .map((l) => {
              const ext = l.external ? ' target="_blank" rel="noopener noreferrer"' : '';
              return `<li><a class="chron-link" href="${esc(l.href)}"${ext}><span>${esc(l.label)}</span><span aria-hidden="true">${l.external ? '↗' : '→'}</span></a></li>`;
            })
            .join('');
        }
      };

      const setActive = (idx, immediate) => {
        const n = visible[idx];
        activeIndex = idx;

        if (counter) {
          counter.innerHTML = n
            ? `${esc(n.no)}<i> / ${pad(allNodes.length)}</i>`
            : `—<i> / ${pad(allNodes.length)}</i>`;
        }
        if (prevBtn) prevBtn.disabled = !n || idx <= 0;
        if (nextBtn) nextBtn.disabled = !n || idx >= visible.length - 1;
        if (focusDate) focusDate.textContent = n ? n.shortDate : '';
        if (scrub && n) scrub.setAttribute('aria-valuenow', String(idx + 1));

        nodeEls.forEach((el, i) => el.classList.toggle('is-active', i === idx));

        if (n && yearBig && n.year !== shownYear) {
          shownYear = n.year;
          const span = yearBig.querySelector('span');
          if (span) span.textContent = String(n.year);
          yearBig.classList.remove('is-entering');
          void yearBig.offsetWidth;
          yearBig.classList.add('is-entering');
        }
        yearBtnEls.forEach((b) => b.classList.toggle('is-active', Boolean(n) && Number(b.dataset.year) === n.year));

        if (!detail) return;
        if (!n) {
          detail.classList.add('hidden');
          return;
        }
        detail.classList.remove('hidden');
        if (swapTimer) clearTimeout(swapTimer);
        if (immediate) {
          detail.classList.remove('is-swapping');
          fillDetail(n);
          return;
        }
        detail.classList.add('is-swapping');
        swapTimer = setTimeout(() => {
          fillDetail(visible[activeIndex] || n);
          detail.classList.remove('is-swapping');
        }, 170);
      };

      const render = () => {
        maxX = Math.max(0, (visible.length - 1) * spacing);
        const empty = visible.length === 0;
        if (emptyEl) emptyEl.classList.toggle('hidden', !empty);

        let html = `<div class="chron-ticks" style="left:-1200px;width:${maxX + 2400}px"></div>`;
        visible.forEach((n, i) => {
          const dir = i % 2 === 0 ? 'up' : 'down';
          const g = glyphs[n.category] || '';
          const tpl = n.isTemplate ? ` <span class="chron-entry-tpl">· ${esc(i18n.templateBadge || '')}</span>` : '';
          html += `
            <div class="chron-node chron-node--${dir}" data-node-index="${i}" style="left:${nodeX(i)}px">
              <span class="chron-marker">${g}</span>
              <div class="chron-entry">
                <div class="chron-entry-meta"><span>No.&nbsp;${esc(n.no)}</span><span>${esc(n.shortDate)}</span></div>
                <h4 class="chron-entry-title">${esc(n.title)}</h4>
                <p class="chron-entry-cat"><span class="glyph">${g}</span>${esc(n.categoryLabel)}${tpl}</p>
              </div>
            </div>`;
        });
        track.innerHTML = empty ? '' : html;
        nodeEls = Array.from(track.querySelectorAll('.chron-node'));

        if (scrubTicks) {
          scrubTicks.innerHTML = visible
            .map((_, i) => `<span class="chron-scrub-tick" style="left:${pct(i)}%"></span>`)
            .join('');
        }

        renderYears();
      };

      const renderYears = () => {
        if (!yearsEl) return;
        const width = yearsEl.clientWidth || 320;
        const seen = new Set();
        let lastPx = -Infinity;
        let yh = '';
        visible.forEach((n, i) => {
          if (seen.has(n.year)) return;
          seen.add(n.year);
          const px = (pct(i) / 100) * width;
          if (px - lastPx < 58) return;
          lastPx = px;
          yh += `<button type="button" class="chron-scrub-year" data-jump="${i}" data-year="${n.year}" style="left:${pct(i)}%">${n.year}</button>`;
        });
        yearsEl.innerHTML = yh;
        yearBtnEls = Array.from(yearsEl.querySelectorAll('[data-jump]'));
        const cur = visible[activeIndex];
        yearBtnEls.forEach((b) => b.classList.toggle('is-active', Boolean(cur) && Number(b.dataset.year) === cur.year));
      };

      /* Focus anchor: centred on wide screens, shifted left on narrow ones so entries stay readable */
      const anchorX = () => Math.min(stageW / 2, Math.max(20, stageW - 250));

      const apply = () => {
        const anchor = anchorX();
        track.style.transform = `translate3d(${anchor - currentX}px,0,0)`;
        if (headEl) headEl.style.left = `${anchor}px`;

        const progress = maxX > 0 ? clamp(currentX / maxX, 0, 1) : 1;
        if (scrubThumb) scrubThumb.style.left = `${progress * 100}%`;
        if (scrubFill) scrubFill.style.width = `${progress * 100}%`;

        const range = Math.max(280, stageW * 0.52);
        for (let i = 0; i < nodeEls.length; i++) {
          const dist = Math.abs(nodeX(i) - currentX);
          nodeEls[i].style.opacity = Math.max(0.2, 1 - dist / range).toFixed(3);
        }

        if (visible.length) {
          const near = nearestIndex(currentX);
          if (near !== activeIndex) setActive(near, false);
        }
      };

      const tick = () => {
        let more = false;
        if (!dragging && !scrubbing) {
          if (Math.abs(velocity) > 0.25) {
            currentX += velocity;
            velocity *= 0.92;
            if (currentX < 0 || currentX > maxX) {
              const edge = currentX < 0 ? 0 : maxX;
              currentX = edge + (currentX - edge) * 0.7;
              velocity *= 0.5;
            }
            if (Math.abs(velocity) <= 0.45) {
              velocity = 0;
              targetX = nodeX(nearestIndex(currentX));
            }
            more = true;
          } else {
            const diff = targetX - currentX;
            if (Math.abs(diff) > 0.3) {
              currentX += diff * 0.14;
              more = true;
            } else {
              currentX = targetX;
            }
          }
          apply();
        }
        raf = more ? requestAnimationFrame(tick) : null;
      };

      const loop = () => {
        if (raf === null) raf = requestAnimationFrame(tick);
      };

      const go = (idx, immediate) => {
        if (!visible.length) return;
        const i = clamp(idx, 0, visible.length - 1);
        velocity = 0;
        targetX = nodeX(i);
        if (immediate) {
          currentX = targetX;
          setActive(i, true);
          apply();
        } else {
          if (i !== activeIndex) setActive(i, false);
          loop();
        }
      };

      /* Drag the stage */
      stage.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        if (!visible.length) return;
        dragging = true;
        pointerId = e.pointerId;
        lastX = e.clientX;
        lastT = performance.now();
        travel = 0;
        velocity = 0;
        const nodeEl = e.target.closest('[data-node-index]');
        pressedIndex = nodeEl ? Number(nodeEl.getAttribute('data-node-index')) : null;
        stage.classList.add('is-dragging');
        try {
          stage.setPointerCapture(e.pointerId);
        } catch {}
      });

      stage.addEventListener('pointermove', (e) => {
        if (!dragging || e.pointerId !== pointerId) return;
        const dx = e.clientX - lastX;
        const now = performance.now();
        const dt = Math.max(1, now - lastT);
        travel += Math.abs(dx);
        if (travel > 6) markInteracted();

        let delta = -dx;
        if ((currentX < 0 && delta < 0) || (currentX > maxX && delta > 0)) delta *= 0.3;
        currentX += delta;
        targetX = currentX;
        velocity = velocity * 0.55 + ((-dx / dt) * 16) * 0.45;

        lastX = e.clientX;
        lastT = now;
        apply();
      });

      const endDrag = (e) => {
        if (!dragging || (pointerId !== null && e.pointerId !== pointerId)) return;
        dragging = false;
        pointerId = null;
        stage.classList.remove('is-dragging');
        try {
          stage.releasePointerCapture(e.pointerId);
        } catch {}

        if (travel <= 6 && pressedIndex !== null) {
          markInteracted();
          go(pressedIndex, false);
          pressedIndex = null;
          return;
        }
        pressedIndex = null;
        if (currentX < 0 || currentX > maxX || Math.abs(velocity) < 0.8) {
          velocity = 0;
          targetX = nodeX(nearestIndex(currentX));
        }
        loop();
      };
      stage.addEventListener('pointerup', endDrag);
      stage.addEventListener('pointercancel', endDrag);

      /* Trackpad / shift-wheel */
      stage.addEventListener(
        'wheel',
        (e) => {
          if (!visible.length) return;
          const horizontal = Math.abs(e.deltaX) > Math.abs(e.deltaY) || e.shiftKey;
          if (!horizontal) return;
          e.preventDefault();
          markInteracted();
          const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
          velocity = 0;
          targetX = clamp(targetX + delta, 0, maxX);
          loop();
          if (wheelTimer) clearTimeout(wheelTimer);
          wheelTimer = setTimeout(() => {
            targetX = nodeX(nearestIndex(targetX));
            loop();
          }, 160);
        },
        { passive: false }
      );

      /* Keyboard */
      stage.addEventListener('keydown', (e) => {
        const map = { ArrowLeft: activeIndex - 1, ArrowRight: activeIndex + 1, Home: 0, End: visible.length - 1 };
        if (!(e.key in map)) return;
        e.preventDefault();
        markInteracted();
        go(map[e.key], false);
      });

      /* Scrubber */
      if (scrub) {
        const scrubTo = (clientX) => {
          if (!visible.length) return;
          const rect = scrub.getBoundingClientRect();
          if (rect.width <= 0) return;
          velocity = 0;
          currentX = clamp((clientX - rect.left) / rect.width, 0, 1) * maxX;
          targetX = currentX;
          apply();
        };
        scrub.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          if (!visible.length) return;
          scrubbing = true;
          markInteracted();
          if (scrubThumb) scrubThumb.classList.add('is-dragging');
          try {
            scrub.setPointerCapture(e.pointerId);
          } catch {}
          scrubTo(e.clientX);
        });
        scrub.addEventListener('pointermove', (e) => {
          if (scrubbing) scrubTo(e.clientX);
        });
        const endScrub = (e) => {
          if (!scrubbing) return;
          scrubbing = false;
          if (scrubThumb) scrubThumb.classList.remove('is-dragging');
          try {
            scrub.releasePointerCapture(e.pointerId);
          } catch {}
          go(nearestIndex(currentX), false);
        };
        scrub.addEventListener('pointerup', endScrub);
        scrub.addEventListener('pointercancel', endScrub);
      }

      if (yearsEl) {
        yearsEl.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-jump]');
          if (!btn) return;
          markInteracted();
          go(Number(btn.dataset.jump), false);
        });
      }

      if (prevBtn) prevBtn.addEventListener('click', () => go(activeIndex - 1, false));
      if (nextBtn) nextBtn.addEventListener('click', () => go(activeIndex + 1, false));

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-tl-filter') || 'all';
          filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          visible = key === 'all' ? allNodes.slice() : allNodes.filter((n) => n.category === key);
          activeIndex = -1;
          render();
          if (visible.length) go(visible.length - 1, true);
          else setActive(-1, true);
        });
      });

      zoomBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-tl-zoom');
          if (!key || !SPACING[key]) return;
          zoomBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          spacing = SPACING[key];
          const keep = activeIndex;
          activeIndex = -1;
          render();
          go(keep, true);
        });
      });

      const onResize = () => {
        stageW = stage.clientWidth || 800;
        renderYears();
        apply();
      };
      if (typeof ResizeObserver !== 'undefined') new ResizeObserver(onResize).observe(stage);
      else window.addEventListener('resize', onResize);

      render();
      const hash = window.location.hash.slice(1);
      const hashIdx = hash ? visible.findIndex((n) => n.id === hash) : -1;
      go(hashIdx !== -1 ? hashIdx : visible.length - 1, true);
    });
  })();
</script>
