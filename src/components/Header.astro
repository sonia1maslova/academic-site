---
import { profile } from '../data/profile';
import { ui } from '../i18n/ui';
import {
  getAlternateLocalePath,
  isActiveRoute,
  localePath,
  type Locale,
} from '../utils/paths';
import Icons from './Icons.astro';

interface Props {
  lang: Locale;
  alternateHref?: string;
}

const { lang, alternateHref } = Astro.props;
const labels = ui[lang];
const targetLang: Locale = lang === 'en' ? 'zh' : 'en';
const switchHref = alternateHref ?? getAlternateLocalePath(Astro.url.pathname, targetLang);

const navItems = [
  { label: labels.nav.home, href: localePath(lang, '') },
  { label: labels.nav.publications, href: localePath(lang, 'publications') },
  { label: labels.nav.projects, href: localePath(lang, 'projects') },
  { label: labels.nav.experience, href: localePath(lang, 'experience') },
  { label: labels.nav.notes, href: localePath(lang, 'notes') },
];

const displayName = lang === 'zh' ? profile.name.en : profile.name.en;
---

<header
  class="sticky top-0 z-40 border-b backdrop-blur-md"
  style="background-color: color-mix(in srgb, var(--bg) 88%, transparent); border-color: var(--border);"
>
  <div class="mx-auto flex max-w-4xl items-center justify-between px-5 py-3.5 sm:px-6">
    <a
      href={localePath(lang, '')}
      class="group flex items-center gap-2.5 text-[var(--fg)] no-underline"
    >
      <span
        class="flex h-7 w-7 items-center justify-center rounded-md font-serif-display text-xs font-semibold tracking-tight transition-colors"
        style="background-color: var(--accent); color: var(--bg);"
      >
        {profile.monogram}
      </span>
      <span class="font-serif-display text-base font-semibold tracking-tight group-hover:text-[var(--accent)]">
        {displayName}
      </span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav aria-label="Main navigation" class="hidden items-center gap-1 md:flex">
        {navItems.map((item) => {
          const active = isActiveRoute(Astro.url.pathname, item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-1.5 text-sm transition-colors',
                active
                  ? 'font-medium text-[var(--accent)] bg-[var(--accent-soft)]'
                  : 'text-[var(--fg-muted)] hover:text-[var(--fg)] hover:bg-[var(--bg-subtle)]',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="hidden h-4 w-px bg-[var(--border)] md:block mx-1" aria-hidden="true" />

      <a
        href={switchHref}
        class="inline-flex h-8 items-center justify-center rounded-md border border-[var(--border)] px-2.5 font-mono-meta text-xs font-medium text-[var(--fg-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] hover:bg-[var(--accent-soft)]"
        title={targetLang === 'zh' ? '切换至中文' : 'Switch to English'}
      >
        {labels.actions.switchLang}
      </a>

      <button
        type="button"
        id="theme-toggle"
        aria-label={labels.actions.switchTheme}
        title={labels.actions.switchTheme}
        class="inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-md border border-[var(--border)] text-[var(--fg-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] hover:bg-[var(--accent-soft)]"
      >
        <span class="dark:hidden">
          <Icons name="moon" class="h-4 w-4" />
        </span>
        <span class="hidden dark:inline">
          <Icons name="sun" class="h-4 w-4" />
        </span>
      </button>

      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label={labels.actions.menu}
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-md border border-[var(--border)] text-[var(--fg-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] md:hidden"
      >
        <Icons name="menu" class="h-4 w-4" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile navigation"
    class="hidden border-t border-[var(--border)] px-5 py-3 md:hidden"
    style="background-color: var(--bg);"
  >
    <div class="flex flex-col gap-1">
      {navItems.map((item) => {
        const active = isActiveRoute(Astro.url.pathname, item.href);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm',
              active
                ? 'font-medium text-[var(--accent)] bg-[var(--accent-soft)]'
                : 'text-[var(--fg-muted)] hover:text-[var(--fg)] hover:bg-[var(--bg-subtle)]',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('academic-site-theme', isDark ? 'dark' : 'light');
        } catch {}
      });
    }

    const menuBtn = document.getElementById('mobile-menu-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    if (menuBtn && mobileNav) {
      menuBtn.addEventListener('click', () => {
        const isHidden = mobileNav.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', String(!isHidden));
      });
    }
  })();
</script>
