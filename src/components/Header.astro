---
import { profile } from '../data/profile';
import { ui } from '../i18n/ui';
import {
  getAlternateLocalePath,
  isActiveRoute,
  localePath,
  type Locale,
} from '../utils/paths';

interface Props {
  lang: Locale;
  alternateHref?: string;
}

const { lang, alternateHref } = Astro.props;
const labels = ui[lang];
const targetLang: Locale = lang === 'en' ? 'zh' : 'en';
const switchHref = alternateHref ?? getAlternateLocalePath(Astro.url.pathname, targetLang);

const navItems = [
  { label: labels.nav.home, href: localePath(lang, '') },
  { label: labels.nav.timeline, href: localePath(lang, 'timeline') },
  { label: labels.nav.publications, href: localePath(lang, 'publications') },
  { label: labels.nav.projects, href: localePath(lang, 'projects') },
  { label: labels.nav.experience, href: localePath(lang, 'experience') },
  { label: labels.nav.notes, href: localePath(lang, 'notes') },
];
---

<header
  class="site-head sticky top-0 z-40 border-b border-ink backdrop-blur-md"
  style="background-color: color-mix(in srgb, var(--paper) 88%, transparent);"
>
  <div class="wrap flex items-center justify-between gap-6 py-3.5">
    <a href={localePath(lang, '')} class="group flex items-baseline gap-3">
      <span class="display text-[1.6rem] leading-none text-ink transition-colors group-hover:text-accent">
        {profile.name.en}
      </span>
      <span class="eyebrow hidden xl:inline">{labels.siteTagline}</span>
    </a>

    <nav aria-label="Main navigation" class="hidden items-center gap-7 lg:flex">
      {navItems.map((item) => {
        const active = isActiveRoute(Astro.url.pathname, item.href);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={['nav-link', active && 'is-active']}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-5">
      <a
        href={switchHref}
        lang={targetLang === 'zh' ? 'zh-CN' : 'en'}
        class="nav-link"
        title={targetLang === 'zh' ? '切换至中文' : 'Switch to English'}
      >
        {labels.actions.switchLang}
      </a>
      <button
        type="button"
        id="theme-toggle"
        class="nav-link inline-flex items-center"
        aria-label={labels.actions.switchTheme}
        title={labels.actions.switchTheme}
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.2" />
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5Z" fill="currentColor" />
        </svg>
      </button>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="nav-link lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        {labels.actions.menu}
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile navigation"
    class="hidden border-t border-rule lg:hidden"
  >
    <ol class="wrap py-4">
      {navItems.map((item, idx) => {
        const active = isActiveRoute(Astro.url.pathname, item.href);
        return (
          <li class="border-b border-rule last:border-b-0">
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex items-baseline gap-4 py-3',
                active ? 'text-accent' : 'text-ink',
              ]}
            >
              <span class="font-mono text-[10px] text-ink-3">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <span class="display text-[1.8rem]">{item.label}</span>
            </a>
          </li>
        );
      })}
    </ol>
  </nav>
</header>

<script is:inline>
  (() => {
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('academic-site-theme', isDark ? 'dark' : 'light');
        } catch {}
      });
    }

    const menuBtn = document.getElementById('mobile-menu-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    if (menuBtn && mobileNav) {
      menuBtn.addEventListener('click', () => {
        const isHidden = mobileNav.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', String(!isHidden));
      });
    }
  })();
</script>
