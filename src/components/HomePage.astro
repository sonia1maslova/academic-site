---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { t, ui } from '../i18n/ui';
import { localePath, withBase, type Locale } from '../utils/paths';
import InteractiveTimeline from './InteractiveTimeline.astro';
import ProjectCard from './ProjectCard.astro';
import PublicationCard from './PublicationCard.astro';
import Section from './Section.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const labels = ui[lang];
const h = labels.home;

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 4);

const selectedPublications = (await getCollection('publications'))
  .filter((p) => p.data.selected)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const recentNotes = (await getCollection('notes'))
  .filter((n) => n.data.lang === lang)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

const nameParts = t(profile.name, lang).trim().split(/\s+/);
const nameLast = nameParts.pop() ?? '';
const nameFirst = nameParts.join(' ');

const updated = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-GB', {
  year: 'numeric',
  month: 'long',
}).format(new Date());

const githubUrl = `https://github.com/${profile.githubUsername}`;
const cvHref = profile.cvPdfPath ? withBase(profile.cvPdfPath) : localePath(lang, 'experience');
const romans = ['i', 'ii', 'iii', 'iv', 'v', 'vi'];
---

<BaseLayout lang={lang}>
  <!-- ============ Masthead / Hero ============ -->
  <section class="pt-6 md:pt-10">
    <div class="rise flex flex-wrap items-baseline justify-between gap-3 border-b border-rule pb-3">
      <p class="eyebrow">{labels.siteTagline} — {t(profile.role, lang)}</p>
      <p class="eyebrow">{h.updated} {updated}</p>
    </div>

    <div class="mt-10 grid grid-cols-12 gap-x-8 gap-y-10 md:mt-16">
      <div class="col-span-12 lg:col-span-8">
        <h1 class="display hero-name rise rise-1 text-ink">
          {nameFirst && <span class="block">{nameFirst}</span>}
          <em class="block pl-[0.06em]">{nameLast}</em>
        </h1>
        <p class="rise rise-2 mt-10 max-w-[34rem] text-[1.32rem] leading-[1.45] text-ink-2 italic md:text-[1.45rem]">
          {t(profile.dek, lang)}
        </p>
      </div>

      <aside class="rise rise-3 col-span-12 sm:col-span-6 lg:col-span-4 lg:pt-4">
        <figure>
          {profile.avatarPath ? (
            <img
              src={withBase(profile.avatarPath)}
              alt={profile.name.en}
              class="aspect-[4/5] w-full object-cover grayscale"
            />
          ) : (
            <div class="fig-hatch relative flex aspect-[4/5] w-full items-end p-4">
              <span class="display absolute top-3 right-4 text-[5.5rem] leading-none text-accent italic">
                {profile.monogram.slice(-1)}
              </span>
              <span class="eyebrow bg-paper px-1.5 py-0.5">{h.figHint}</span>
            </div>
          )}
          <figcaption class="mt-3 flex items-baseline justify-between gap-3 border-t border-rule pt-2 text-[13.5px] italic text-ink-3">
            <span>{h.figCaption}</span>
            <span class="font-mono text-[10px] not-italic tracking-[0.12em]">YD/2026</span>
          </figcaption>
        </figure>
      </aside>
    </div>
  </section>

  {profile.showTemplateBanner && (
    <aside class="mt-14 flex flex-col gap-2 border border-dashed border-rule-strong px-5 py-4 sm:flex-row sm:items-baseline sm:gap-6">
      <p class="eyebrow shrink-0 text-accent">{h.editorNote}</p>
      <p class="text-[14.5px] leading-relaxed text-ink-2">{h.templateNoticeBody}</p>
    </aside>
  )}

  <!-- ============ 01 Abstract ============ -->
  <section class="mt-16 grid grid-cols-12 gap-x-8 gap-y-8 border-t border-ink pt-5 md:mt-20">
    <div class="col-span-12 md:col-span-3">
      <p class="eyebrow">
        <span class="text-accent">01</span><span class="mx-2">—</span>{h.abstract}
      </p>
    </div>

    <div class="col-span-12 md:col-span-9 lg:col-span-6">
      <div class="dropcap space-y-5 text-[1.15rem] leading-[1.72] text-ink">
        {profile.bio[lang].map((p) => <p>{p}</p>)}
      </div>
      <div class="mt-8 flex flex-wrap gap-x-7 gap-y-3">
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn-text">
          {labels.actions.github} <span aria-hidden="true">↗</span>
        </a>
        <a href={`mailto:${profile.email}`} class="btn-text">
          {labels.actions.contactEmail} <span aria-hidden="true">→</span>
        </a>
        <a href={cvHref} class="btn-text">
          {labels.actions.downloadCv} <span aria-hidden="true">→</span>
        </a>
        {profile.googleScholarUrl && (
          <a href={profile.googleScholarUrl} target="_blank" rel="noopener noreferrer" class="btn-text">
            {labels.actions.googleScholar} <span aria-hidden="true">↗</span>
          </a>
        )}
        {profile.orcidUrl && (
          <a href={profile.orcidUrl} target="_blank" rel="noopener noreferrer" class="btn-text">
            {labels.actions.orcid} <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>

    <dl class="meta-list col-span-12 md:col-span-9 md:col-start-4 lg:col-span-3 lg:col-start-auto">
      <div>
        <dt class="eyebrow">{h.affiliation}</dt>
        <dd>{t(profile.affiliation, lang)}</dd>
      </div>
      <div>
        <dt class="eyebrow">{h.basedIn}</dt>
        <dd>{t(profile.location, lang)}</dd>
      </div>
      <div>
        <dt class="eyebrow">{h.contact}</dt>
        <dd>
          <a href={`mailto:${profile.email}`} class="link-line break-all">{profile.email}</a>
        </dd>
      </div>
      <div>
        <dt class="eyebrow">{h.keywords}</dt>
        <dd class="italic text-ink-2">
          {profile.researchInterests.map((r) => t(r.title, lang)).join(' · ')}
        </dd>
      </div>
    </dl>
  </section>

  <!-- ============ 02 Research interests ============ -->
  <Section num="02" kicker={h.interests.kicker} title={h.interests.title} titleEm={h.interests.em}>
    <ol class="grid gap-x-10 sm:grid-cols-2">
      {profile.researchInterests.map((item, idx) => (
        <li class="border-t border-rule pt-4 pb-9">
          <span class="display text-[1.7rem] leading-none text-accent italic">{romans[idx]}.</span>
          <h3 class="mt-3 text-[1.24rem] leading-snug font-medium text-ink">{t(item.title, lang)}</h3>
          <p class="mt-2 text-[15.5px] leading-relaxed text-ink-2">{t(item.description, lang)}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- ============ 03 Chronicle (inverted spread) ============ -->
  <section class="band band-ink mt-28 py-14 md:mt-36 md:py-20">
    <div class="wrap">
      <div class="flex items-baseline justify-between gap-4 border-t border-ink pt-3">
        <p class="eyebrow">
          <span class="text-accent">03</span><span class="mx-2">—</span>{h.chronicle.kicker}
        </p>
        <a href={localePath(lang, 'timeline')} class="btn-text">
          {h.fullTimeline} <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="mt-8 mb-12 grid grid-cols-12 items-end gap-x-8 gap-y-5">
        <h2 class="display col-span-12 text-[clamp(2.8rem,7vw,5.6rem)] leading-[0.9] text-ink md:col-span-7">
          {h.chronicle.title} <em>{h.chronicle.em}</em>
        </h2>
        <p class="col-span-12 text-[1.02rem] leading-relaxed text-ink-2 md:col-span-5 md:pb-2">
          {labels.timeline.subtitle}
        </p>
      </div>
      <InteractiveTimeline lang={lang} compact={true} />
    </div>
  </section>

  <!-- ============ 04 Selected works ============ -->
  <Section
    num="04"
    kicker={h.works.kicker}
    title={h.works.title}
    titleEm={h.works.em}
    linkHref={localePath(lang, 'projects')}
    linkLabel={`${labels.actions.viewAll} (${allProjects.length})`}
    layout="stacked"
  >
    <ol class="border-t border-rule">
      {featuredProjects.map((project, idx) => (
        <ProjectCard entry={project} lang={lang} index={idx} compact={true} />
      ))}
    </ol>
  </Section>

  <!-- ============ 05 Selected publications ============ -->
  <Section
    num="05"
    kicker={h.pubs.kicker}
    title={h.pubs.title}
    titleEm={h.pubs.em}
    linkHref={localePath(lang, 'publications')}
    linkLabel={labels.actions.viewAll}
  >
    <div class="border-t border-rule">
      {selectedPublications.map((pub) => <PublicationCard entry={pub} lang={lang} />)}
    </div>
  </Section>

  <!-- ============ 06 Notes ============ -->
  {recentNotes.length > 0 && (
    <Section
      num="06"
      kicker={h.notes.kicker}
      title={h.notes.title}
      titleEm={h.notes.em}
      linkHref={localePath(lang, 'notes')}
      linkLabel={labels.actions.viewAll}
    >
      <ol class="border-t border-rule">
        {recentNotes.map((note) => (
          <li class="border-b border-rule">
            <a href={localePath(lang, `notes/${note.data.slugKey}`)} class="group block py-6">
              <p class="eyebrow">
                {note.data.date} · {note.data.readingTime} {labels.notes.readingTime}
              </p>
              <h3 class="display mt-2 text-[clamp(1.6rem,2.8vw,2.2rem)] leading-[1.08] text-ink transition-colors group-hover:text-accent">
                {note.data.title}
              </h3>
              <p class="mt-2 max-w-2xl text-[15.5px] leading-relaxed text-ink-2">{note.data.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </Section>
  )}
</BaseLayout>
