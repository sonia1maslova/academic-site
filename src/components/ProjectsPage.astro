---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';
import type { Locale } from '../utils/paths';
import PageHeader from './PageHeader.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const labels = ui[lang].projects;

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const filters = (['all', 'software', 'research', 'visualization', 'tool', 'notes'] as const)
  .map((key) => ({
    key,
    label: labels[key],
    count: key === 'all' ? projects.length : projects.filter((p) => p.data.category === key).length,
  }))
  .filter((f) => f.count > 0);
---

<BaseLayout lang={lang} title={`${labels.title} ${labels.em}`} description={labels.subtitle}>
  <PageHeader
    kicker={labels.kicker}
    title={labels.title}
    titleEm={labels.em}
    lede={labels.subtitle}
    meta={`${projects.length} ${labels.entries}`}
  />

  <div class="mt-14 flex flex-wrap gap-x-7 gap-y-2 border-b border-ink pb-3" role="group">
    {filters.map((f, idx) => (
      <button
        type="button"
        class="filter-btn"
        data-proj-filter={f.key}
        aria-pressed={idx === 0 ? 'true' : 'false'}
      >
        <span>{f.label}</span>
        <sup>{f.count}</sup>
      </button>
    ))}
  </div>

  <ol>
    {projects.map((project, idx) => <ProjectCard entry={project} lang={lang} index={idx} />)}
  </ol>

  <p class="mt-16 text-center text-ink-3 italic" data-proj-empty hidden>{labels.empty}</p>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-proj-filter]');
  const items = document.querySelectorAll<HTMLElement>('.project-item');
  const empty = document.querySelector<HTMLElement>('[data-proj-empty]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.projFilter ?? 'all';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      items.forEach((item) => {
        const show = key === 'all' || item.dataset.projectCategory === key;
        item.toggleAttribute('hidden', !show);
        if (show) shown += 1;
      });
      empty?.toggleAttribute('hidden', shown > 0);
    });
  });
</script>
