---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../utils/paths';
import PageHeader from './PageHeader.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const labels = ui[lang].notes;
const actions = ui[lang].actions;

const notes = (await getCollection('notes'))
  .filter((n) => n.data.lang === lang)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout lang={lang} title={`${labels.title} ${labels.em}`} description={labels.subtitle}>
  <PageHeader
    kicker={labels.kicker}
    title={labels.title}
    titleEm={labels.em}
    lede={labels.subtitle}
    meta={`${notes.length} ${labels.entries}`}
  />

  {notes.length === 0 ? (
    <p class="mt-16 text-ink-3 italic">{labels.empty}</p>
  ) : (
    <ol class="mt-14 border-t border-ink">
      {notes.map((note, idx) => (
        <li class="border-b border-rule">
          <a
            href={localePath(lang, `notes/${note.data.slugKey}`)}
            class="group grid grid-cols-12 gap-x-6 gap-y-3 py-9"
          >
            <div class="col-span-12 md:col-span-2">
              <p class="font-mono text-[10.5px] tracking-[0.1em] text-accent">
                {String(notes.length - idx).padStart(2, '0')}
              </p>
              <p class="mt-2 font-mono text-[10.5px] leading-relaxed tracking-[0.08em] text-ink-3">
                {note.data.date}
                <br />
                {note.data.readingTime} {labels.readingTime}
              </p>
            </div>
            <div class="col-span-12 md:col-span-7">
              <h2 class="display text-[clamp(1.9rem,3.6vw,2.9rem)] leading-[1.02] text-ink transition-colors group-hover:text-accent">
                {note.data.title}
              </h2>
              <p class="mt-3 max-w-2xl text-[1.02rem] leading-relaxed text-ink-2">{note.data.summary}</p>
            </div>
            <div class="col-span-12 flex items-baseline justify-between gap-4 md:col-span-3 md:flex-col md:items-end md:text-right">
              <p class="font-mono text-[10.5px] tracking-[0.06em] text-ink-3">{note.data.tags.join(' / ')}</p>
              <span class="btn-text">
                {actions.readNote} <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  )}
</BaseLayout>
